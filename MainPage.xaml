<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatriceMaui.MainPage"
             BackgroundColor="#1E1E1E">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="15">

        <Border Grid.Row="0" Stroke="#333333" StrokeThickness="2" BackgroundColor="#2D2D2D" Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <ScrollView Orientation="Horizontal" HorizontalOptions="End">
                <VerticalStackLayout Spacing="5" HorizontalOptions="End">
                    <Label x:Name="LblOperation" Text="" FontSize="18" TextColor="#888888" HorizontalTextAlignment="End" />
                    <Label x:Name="LblResultat" Text="0" FontSize="40" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*,*" ColumnSpacing="10" RowSpacing="10">
            <Button Text="C" Grid.Row="0" Grid.Column="0" Clicked="OnClearClicked" BackgroundColor="#A5A5A5" TextColor="Black"/>
            <Button Text="+/-" Grid.Row="0" Grid.Column="1" Clicked="OnSignClicked" BackgroundColor="#A5A5A5" TextColor="Black"/>
            <Button Text="%" Grid.Row="0" Grid.Column="2" Clicked="OnPercentClicked" BackgroundColor="#A5A5A5" TextColor="Black"/>
            <Button Text="÷" Grid.Row="0" Grid.Column="3" Clicked="OnOperationClicked" BackgroundColor="#FF9F0A" TextColor="White"/>

            <Button Text="7" Grid.Row="1" Grid.Column="0" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="8" Grid.Row="1" Grid.Column="1" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="9" Grid.Row="1" Grid.Column="2" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="×" Grid.Row="1" Grid.Column="3" Clicked="OnOperationClicked" BackgroundColor="#FF9F0A" TextColor="White"/>

            <Button Text="4" Grid.Row="2" Grid.Column="0" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="5" Grid.Row="2" Grid.Column="1" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="6" Grid.Row="2" Grid.Column="2" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="-" Grid.Row="2" Grid.Column="3" Clicked="OnOperationClicked" BackgroundColor="#FF9F0A" TextColor="White"/>

            <Button Text="1" Grid.Row="3" Grid.Column="0" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="2" Grid.Row="3" Grid.Column="1" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="3" Grid.Row="3" Grid.Column="2" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="+" Grid.Row="3" Grid.Column="3" Clicked="OnOperationClicked" BackgroundColor="#FF9F0A" TextColor="White"/>

            <Button Text="⌫" Grid.Row="4" Grid.Column="0" Clicked="OnEraseClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="0" Grid.Row="4" Grid.Column="1" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="." Grid.Row="4" Grid.Column="2" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White"/>
            <Button Text="=" Grid.Row="4" Grid.Column="3" Clicked="OnCalculateClicked" BackgroundColor="#FF9F0A" TextColor="White"/>
        </Grid>
    </Grid>
</ContentPage>